# Public build-time key; may be overridden for another Turnstile widget.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEcvxetyNa4pZ6kY

# Production builds use true; preview builds explicitly override this to false.
PUBLIC_SITE_INDEXABLE=true

# Worker secrets are set with `wrangler secret put`, never in this file.
# TURNSTILE_SECRET_KEY
# CONTACT_WEBHOOK_URL
# CONTACT_WEBHOOK_TOKEN
