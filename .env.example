# Public build-time setting. Leave empty until a Turnstile widget is created.
PUBLIC_TURNSTILE_SITE_KEY=

# Keep false until production legal/content/form verification is complete.
PUBLIC_SITE_INDEXABLE=false

# Worker secrets are set with `wrangler secret put`, never in this file.
# TURNSTILE_SECRET_KEY
# CONTACT_WEBHOOK_URL
# CONTACT_WEBHOOK_TOKEN
