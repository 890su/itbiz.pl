{
  "name": "itbiz-pl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "cross-env PUBLIC_SITE_INDEXABLE=true astro build",
    "build:preview": "cross-env PUBLIC_SITE_INDEXABLE=false astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --env production",
    "deploy:preview": "npm run build:preview && wrangler deploy --env=\"\"",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260826.1",
    "@playwright/test": "1.62.1",
    "cross-env": "10.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
