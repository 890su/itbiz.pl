---
import '../styles/global.css';
import SiteChrome from '../components/SiteChrome.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentControls from '../components/ConsentControls.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const siteIndexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';
const effectiveNoindex = noindex || !siteIndexable;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ITBIZ.PL',
  url: Astro.site,
  inLanguage: 'pl-PL',
};
---

<!doctype html>
<html lang="pl" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0b1324" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={effectiveNoindex ? 'noindex, follow' : 'index, follow'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ITBIZ.PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script is:inline src="/scripts/theme.js"></script>
    <script is:inline src="/scripts/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <div class="site-shell">
      <div class="content-rail">
        <SiteChrome variant="mobile" />
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
        <SiteFooter />
      </div>
      <SiteChrome variant="desktop" />
    </div>
    <ConsentControls />
  </body>
</html>
