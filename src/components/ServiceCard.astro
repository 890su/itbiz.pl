---
interface Props {
  href: string;
  title: string;
  filterIds?: readonly string[];
  headingLevel?: 'h2' | 'h3';
}
const { href, title, filterIds = [] } = Astro.props;
const Heading = Astro.props.headingLevel ?? 'h3';
---

<article
  class="service-card compact-service-card"
  data-service-card={filterIds.length ? '' : undefined}
  data-service-filters={filterIds.length ? filterIds.join(' ') : undefined}
>
  <Heading
    ><a href={href}
      >{title}<svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
      ></a
    ></Heading
  >
</article>
