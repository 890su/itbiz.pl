---
import { company } from '../data/company';
import { getRoute, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale);
---

<footer class="site-footer">
  <div>
    <strong>{company.brand}</strong>
    <p>{company.legalName} · NIP {company.nip}</p>
    <address class="footer-contact" aria-label={copy.common.nav[4]}>
      <a href={company.publicPhoneHref}>{company.publicPhone}</a>
      <a href={company.publicEmailHref}>{company.publicEmail}</a>
    </address>
  </div>
  <nav aria-label={copy.common.legalNav}>
    <a href={getRoute(locale, 'privacy')}>{copy.common.privacy}</a>
    <a href={getRoute(locale, 'cookies')}>{copy.common.cookies}</a>
    <button type="button" class="text-button" data-privacy-settings
      >{copy.common.privacySettings}</button
    >
  </nav>
</footer>
