---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale).consent;
---

<section
  class="consent-banner"
  data-consent-banner
  hidden
  aria-labelledby="consent-title"
>
  <div>
    <p class="section-label">{copy.label}</p>
    <h2 id="consent-title">{copy.title}</h2>
    <p>{copy.lead}</p>
  </div>
  <div class="consent-actions">
    <button class="button button-secondary" type="button" data-consent-reject
      >{copy.reject}</button
    >
    <button class="button button-secondary" type="button" data-consent-customize
      >{copy.customize}</button
    >
    <button class="button button-secondary" type="button" data-consent-accept
      >{copy.accept}</button
    >
  </div>
</section>

<dialog
  class="consent-dialog"
  data-consent-dialog
  aria-labelledby="privacy-settings-title"
>
  <form method="dialog" data-consent-form>
    <header>
      <p class="section-label">{copy.settings}</p>
      <h2 id="privacy-settings-title">{copy.dialogTitle}</h2>
    </header>
    <label class="consent-option">
      <span><strong>{copy.necessary}</strong><small>{copy.necessaryHelp}</small></span>
      <input type="checkbox" checked disabled />
    </label>
    <label class="consent-option">
      <span><strong>{copy.analytics}</strong><small>{copy.analyticsHelp}</small></span>
      <input type="checkbox" name="analytics" />
    </label>
    <label class="consent-option">
      <span
        ><strong>{copy.advertising}</strong><small>{copy.advertisingHelp}</small></span
      >
      <input type="checkbox" name="advertising" />
    </label>
    <div class="consent-actions">
      <button class="button button-secondary" type="button" data-consent-dialog-reject
        >{copy.reject}</button
      >
      <button class="button button-primary" type="submit">{copy.save}</button>
    </div>
  </form>
</dialog>

<script is:inline src="/scripts/consent.js" defer></script>
