---
import { getCollection } from 'astro:content';

interface Props {
  selectedServiceId?: string;
  heading?: string;
}

const { selectedServiceId = '', heading = 'Opisz zadanie firmowe' } = Astro.props;
const services = await getCollection('services');
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="form-block">
  <div class="section-head">
    <p class="section-label">Zapytanie B2B</p>
    <h2>{heading}</h2>
    <p>
      Podaj kontekst organizacji. Zakres, dostępność i warunki potwierdzimy przed pracą.
    </p>
  </div>
  <form class="lead-form" action="/api/contact" method="post" data-lead-form novalidate>
    <div class="form-grid">
      <div class="field">
        <label for="companyName">Nazwa firmy lub organizacji</label>
        <input
          id="companyName"
          name="companyName"
          autocomplete="organization"
          maxlength="120"
          required
        />
      </div>
      <div class="field">
        <label for="contactName">Osoba kontaktowa</label>
        <input
          id="contactName"
          name="contactName"
          autocomplete="name"
          maxlength="100"
          required
        />
      </div>
      <div class="field">
        <label for="email">E-mail służbowy</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="160"
        />
        <small>Podaj e-mail lub telefon.</small>
      </div>
      <div class="field">
        <label for="phone">Telefon</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
        <small>Podaj telefon lub e-mail.</small>
      </div>
      <div class="field field-wide">
        <label for="serviceId">Temat</label>
        <select id="serviceId" name="serviceId" required>
          <option value="">Wybierz zakres</option>
          {
            services.map((service) => (
              <option
                value={service.data.serviceId}
                selected={selectedServiceId === service.data.serviceId}
              >
                {service.data.formOption}
              </option>
            ))
          }
          <option value="other">Inne zadanie dotyczące infrastruktury firmy</option>
        </select>
      </div>
      <div class="field field-wide">
        <label for="message">Co dzieje się w firmowej infrastrukturze?</label>
        <textarea
          id="message"
          name="message"
          maxlength="3000"
          required
          aria-describedby="message-help"></textarea>
        <small id="message-help"
          >Opisz lokalizację, liczbę stanowisk i zauważone objawy, jeśli są znane.</small
        >
      </div>
    </div>
    <label class="checkbox-field">
      <input name="actingForBusiness" type="checkbox" value="true" required />
      <span
        >Kontaktuję się w imieniu firmy, organizacji, biura lub innego podmiotu.</span
      >
    </label>
    <div class="field visually-hidden" aria-hidden="true">
      <label for="website">Strona internetowa</label>
      <input id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="locale" value="pl" />
    <input type="hidden" name="pagePath" value={Astro.url.pathname} />
    {
      siteKey && (
        <div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" />
      )
    }
    <p class="form-notice">
      Dane wykorzystamy do odpowiedzi na to zapytanie. Szczegóły znajdują się w
      <a href="/privacy/">informacji o prywatności</a>.
    </p>
    <div class="form-status" role="status" aria-live="polite" data-form-status></div>
    <button class="button button-primary" type="submit">Wyślij zapytanie B2B</button>
  </form>
</div>

{
  siteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}
<script is:inline src="/scripts/contact-form.js" defer></script>
