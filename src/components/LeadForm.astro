---
import { getRoute, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { company } from '../data/company';
import { getExperience } from '../i18n/experience';
import { getEnquiry } from '../i18n/enquiry';
import LeadMessage from './LeadMessage.astro';
import LeadIdentity from './LeadIdentity.astro';
interface Props {
  selectedServiceId?: string;
  heading?: string;
  submitLabel?: string;
  photoHelp?: string;
  locale: Locale;
  progressive?: boolean;
  examples?: { text: string; serviceId?: string }[];
  idPrefix?: string;
}
const {
  selectedServiceId = 'other',
  locale,
  progressive = false,
  examples = [],
  idPrefix = '',
} = Astro.props;
const copy = getUi(locale).form;
const enquiry = getEnquiry(locale);
const validation = getExperience(locale).form;
const heading = Astro.props.heading ?? copy.heading;
const submitLabel = Astro.props.submitLabel ?? copy.submit;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAEcvxetyNa4pZ6kY';
const contactId = `${idPrefix}contactMethod`;
---

<div class="form-block lead-enquiry" id={progressive ? 'enquiry' : undefined}>
  <div class="section-head">
    <h2 id={`${idPrefix}form-title`}>{progressive ? enquiry.heading : heading}</h2>
  </div>
  <form
    class="lead-form"
    action="/api/contact"
    method="post"
    data-lead-form
    data-progressive-enquiry={progressive || undefined}
    data-submit-label={submitLabel}
    data-sending-label={copy.sending}
    data-missing-contact={copy.missingContact}
    data-generic-error={copy.genericError}
    data-success-label={copy.success}
    data-preview-label={copy.preview}
    data-request-label={copy.requestNumber}
    data-turnstile-src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    data-verifying-label={enquiry.verifying}
    data-verification-error={enquiry.verificationError}
    novalidate
  >
    <div
      class="validation-summary"
      tabindex="-1"
      role="alert"
      data-validation-summary
      hidden
    >
      <p>{validation.errorsTitle}</p><ul></ul>
    </div>
    <LeadMessage {locale} {progressive} {idPrefix} />
    {
      progressive && (
        <div class="enquiry-examples" data-enquiry-examples>
          <div class="enquiry-example-heading">
            <>
              <span>{enquiry.examples}</span>
              <button
                type="button"
                data-examples-all
                data-all={enquiry.all}
                data-less={enquiry.less}
                aria-expanded="false"
                aria-controls={`${idPrefix}enquiry-examples`}
              >
                {enquiry.all}
              </button>
            </>
          </div>
          <div class="enquiry-example-list" id={`${idPrefix}enquiry-examples`}>
            {examples.map((example) => (
              <button
                type="button"
                data-enquiry-example
                data-service-id={example.serviceId}
              >
                <span>{example.text}</span>
              </button>
            ))}
          </div>
        </div>
      )
    }
    <div
      class="enquiry-details"
      data-enquiry-details={progressive || undefined}
      hidden={progressive}
    >
      {
        progressive && (
          <>
            <fieldset class="enquiry-choices">
              <legend>{enquiry.type}</legend>
              <label>
                <>
                  <input type="radio" name="requestType" value="broken" />
                  <span>{enquiry.broken}</span>
                </>
              </label>
              <label>
                <>
                  <input type="radio" name="requestType" value="setup" />
                  <span>{enquiry.setup}</span>
                </>
              </label>
            </fieldset>
            <fieldset class="enquiry-choices enquiry-urgency">
              <legend>{enquiry.urgency}</legend>
              <label>
                <>
                  <input type="radio" name="urgency" value="urgent" />
                  <span>{enquiry.urgent}</span>
                </>
              </label>
              <label>
                <>
                  <input type="radio" name="urgency" value="soon" />
                  <span>{enquiry.soon}</span>
                </>
              </label>
              <label>
                <>
                  <input type="radio" name="urgency" value="flexible" />
                  <span>{enquiry.flexible}</span>
                </>
              </label>
            </fieldset>
          </>
        )
      }
      <div class="field">
        <label class="visually-hidden" for={contactId}>{copy.contactMethod}</label>
        <input
          id={contactId}
          name="contact"
          type="text"
          maxlength="160"
          placeholder={copy.contactMethod}
          required
          aria-describedby={`${contactId}-error`}
          data-validation-message={validation.contactError}
        />
        <small id={`${contactId}-error`} class="field-error" hidden></small>
      </div>
      <input type="hidden" name="serviceId" value={selectedServiceId || 'other'} />
      <details class="enquiry-extras">
        <summary>{enquiry.extras} <span>({enquiry.optional})</span></summary>
        <div class="form-grid"><LeadIdentity {locale} {idPrefix} /></div>
        {
          Astro.props.photoHelp && (
            <p class="photo-help">
              {Astro.props.photoHelp}{' '}
              <a href={company.publicEmailHref}>{company.publicEmail}</a>
            </p>
          )
        }
      </details>
      <div class="field visually-hidden" aria-hidden="true">
        <label for={`${idPrefix}website`}>{copy.website}</label><input
          id={`${idPrefix}website`}
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <input type="hidden" name="locale" value={locale} /><input
        type="hidden"
        name="pagePath"
        value={Astro.url.pathname}
      />
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action="contact"
        data-language={locale}
        data-size="compact"
        data-appearance="interaction-only"
        data-theme="dark"
      >
      </div>
      <p class="form-notice">
        {copy.notice}
        <a href={getRoute(locale, 'privacy')}>{copy.privacyLink}</a>.
      </p>
      <button class="button button-primary" type="submit">{submitLabel}</button>
    </div>
    <div class="form-status" role="status" tabindex="-1" data-form-status></div>
    <noscript
      ><p>
        <a href={company.publicPhoneHref}
          >{getUi(locale).common.phoneAction}: {company.publicPhone}</a
        >
      </p></noscript
    >
  </form>
</div>
