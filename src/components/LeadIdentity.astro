---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { getEnquiry } from '../i18n/enquiry';
interface Props {
  locale: Locale;
  idPrefix: string;
}
const { locale, idPrefix } = Astro.props;
const copy = getUi(locale).form;
const enquiry = getEnquiry(locale);
const fields = [
  {
    id: 'contactName',
    name: 'contactName',
    label: copy.contact,
    autocomplete: 'name',
    max: 100,
  },
  {
    id: 'companyName',
    name: 'companyName',
    label: copy.company,
    autocomplete: 'organization',
    max: 120,
  },
  {
    id: 'officeAddress',
    name: 'address',
    label: enquiry.address,
    autocomplete: 'street-address',
    max: 300,
  },
];
---

{
  fields.map((field) => (
    <div class="field">
      <label class="visually-hidden" for={`${idPrefix}${field.id}`}>
        {field.label}
      </label>
      <input
        id={`${idPrefix}${field.id}`}
        name={field.name}
        placeholder={field.label}
        autocomplete={field.autocomplete}
        maxlength={field.max}
      />
    </div>
  ))
}
