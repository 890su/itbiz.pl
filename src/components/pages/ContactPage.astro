---
import BaseLayout from '../../layouts/BaseLayout.astro';
import B2BBadge from '../B2BBadge.astro';
import LeadForm from '../LeadForm.astro';
import { getRoute, type Locale } from '../../i18n/config';
import { getUi } from '../../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.contact;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={getRoute(locale, 'contact')}
  {locale}
  translationKey="contact"
>
  <nav class="breadcrumb" aria-label={ui.common.scope}>
    <ol>
      <li><a href={getRoute(locale, 'home')}>{ui.common.start}</a></li><li
        aria-current="page"
      >
        {ui.common.nav[4]}
      </li>
    </ol>
  </nav>
  <header class="page-hero">
    <B2BBadge {locale} /><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.h1}</h1><p>
      {copy.lead}
    </p>
  </header>
  <section class="page-section"><LeadForm {locale} /></section>
</BaseLayout>
