---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import CctvServicePage from './CctvServicePage.astro';
import StandardServicePage from './StandardServicePage.astro';

interface Props {
  locale: Locale;
  service: CollectionEntry<'services'>;
}
const Page =
  Astro.props.service.data.serviceId === 'cctv-emergency'
    ? CctvServicePage
    : StandardServicePage;
---

<Page {...Astro.props} />
