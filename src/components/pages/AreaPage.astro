---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactActions from '../ContactActions.astro';
import { getRoute, type Locale } from '../../i18n/config';
import { getUi } from '../../i18n/ui';
import { getCompact } from '../../i18n/compact';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.area;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={getRoute(locale, 'area.warsaw')}
  {locale}
  translationKey="area.warsaw"
  pageClass="compact-page"
>
  <nav class="breadcrumb" aria-label={ui.common.scope}>
    <ol>
      <li><a href={getRoute(locale, 'home')}>{ui.common.start}</a></li>
      <li aria-current="page">{ui.common.warsaw}</li>
    </ol>
  </nav>
  <header class="page-hero">
    <h1>{copy.h1}</h1><p>{getCompact(locale).areaLead}</p>
    <ContactActions {locale} compact />
    <a class="all-services-link" href={getRoute(locale, 'services')}
      >{ui.common.services}</a
    >
  </header>
</BaseLayout>
