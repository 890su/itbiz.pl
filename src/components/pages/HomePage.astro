---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import B2BBadge from '../B2BBadge.astro';
import NetworkBlueprint from '../NetworkBlueprint.astro';
import ServiceCard from '../ServiceCard.astro';
import LeadForm from '../LeadForm.astro';
import { getRoute, type Locale, type TranslationKey } from '../../i18n/config';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale).home;
const order = ['managed-it', 'lan-installation', 'office-wifi', 'network-repair'];
const services = (await getCollection('services'))
  .filter((service) => service.data.locale === locale)
  .sort((a, b) => order.indexOf(a.data.serviceId) - order.indexOf(b.data.serviceId));
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={getRoute(locale, 'home')}
  {locale}
  translationKey="home"
>
  <section class="hero">
    <div class="hero-copy">
      <B2BBadge {locale} />
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.h1}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#enquiry">{copy.primary}</a>
        <a class="button button-secondary" href={getRoute(locale, 'services')}
          >{copy.secondary}</a
        >
      </div>
      <div class="hero-note" aria-label={copy.serviceLabel}>
        {copy.notes.map((note) => <span>{note}</span>)}
      </div>
    </div>
    <NetworkBlueprint {locale} />
  </section>

  <section class="page-section" aria-labelledby="services-title">
    <header class="section-head">
      <p class="section-label">{copy.serviceLabel}</p>
      <h2 id="services-title">{copy.serviceTitle}</h2>
      <p>{copy.serviceLead}</p>
    </header>
    <div class="service-grid">
      {
        services.map((service, index) => (
          <ServiceCard
            href={getRoute(locale, service.data.translationKey as TranslationKey)}
            index={String(index + 1).padStart(2, '0')}
            title={service.data.title}
            description={service.data.description}
            tags={copy.tags[service.data.serviceId as keyof typeof copy.tags] ?? []}
            {locale}
          />
        ))
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="process-title">
    <header class="section-head">
      <p class="section-label">{copy.processLabel}</p>
      <h2 id="process-title">{copy.processTitle}</h2>
      <p>{copy.processLead}</p>
    </header>
    <div class="process-grid">
      {
        copy.process.map(([index, title, description]) => (
          <article class="process-step">
            <span>{index}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="eligibility-title">
    <div class="scope-grid">
      <div class="info-panel">
        <p class="section-label">{copy.forWhomLabel}</p>
        <h2 id="eligibility-title">{copy.forWhomTitle}</h2>
        <ul class="check-list">{copy.forWhom.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="info-panel">
        <p class="section-label">{copy.boundaryLabel}</p>
        <h2>{copy.boundaryTitle}</h2>
        <p>{copy.boundary}</p>
      </div>
    </div>
  </section>

  <section id="enquiry" class="page-section">
    <LeadForm {locale} />
  </section>
</BaseLayout>
