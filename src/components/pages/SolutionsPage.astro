---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRoute, type Locale } from '../../i18n/config';
import { getUi } from '../../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.solutions;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={getRoute(locale, 'solutions')}
  {locale}
  translationKey="solutions"
>
  <nav class="breadcrumb" aria-label={ui.common.scope}>
    <ol>
      <li><a href={getRoute(locale, 'home')}>{ui.common.start}</a></li><li
        aria-current="page"
      >
        {ui.common.nav[2]}
      </li>
    </ol>
  </nav>
  <header class="page-hero">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.h1}</h1><p>{copy.lead}</p>
  </header>
  <section class="page-section">
    <div class="service-grid">
      {
        copy.items.map(([index, title, description]) => (
          <article class="service-card">
            <>
              <div class="card-index">{index}</div>
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
