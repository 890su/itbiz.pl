---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale).network;
---

<figure class="blueprint" aria-labelledby="blueprint-title">
  <figcaption id="blueprint-title" class="visually-hidden">{copy.caption}</figcaption>
  <svg viewBox="0 0 620 400" role="img" aria-labelledby="network-title network-desc">
    <title id="network-title">{copy.title}</title>
    <desc id="network-desc">{copy.description}</desc>
    <g class="network-path" aria-hidden="true">
      <path d="M175 82H225M395 82H445M530 145V210H90V265M310 210V265M530 210V265"
      ></path>
      <circle cx="200" cy="82" r="4"></circle>
      <circle cx="420" cy="82" r="4"></circle>
      <circle cx="90" cy="210" r="5"></circle>
      <circle cx="310" cy="210" r="5"></circle>
      <circle cx="530" cy="210" r="5"></circle>
    </g>
    <g class="node">
      <rect x="5" y="30" width="170" height="105" rx="10"></rect>
      <text class="node-kicker" x="90" y="65">WAN</text>
      <text class="node-label" x="90" y="101">{copy.devices[0]}</text>
    </g>
    <g class="node">
      <rect x="225" y="30" width="170" height="105" rx="10"></rect>
      <text class="node-kicker" x="310" y="65">EDGE</text>
      <text class="node-label" x="310" y="101">{copy.devices[1]}</text>
    </g>
    <g class="node">
      <rect x="445" y="20" width="170" height="125" rx="10"></rect>
      <text class="node-kicker" x="530" y="62">CORE</text>
      <text class="node-label" x="530" y="102">{copy.devices[2]}</text>
    </g>
    <g class="node node-endpoint">
      <rect x="5" y="265" width="170" height="105" rx="10"></rect>
      <text class="node-kicker" x="90" y="302">VLAN 10</text>
      <text class="node-label" x="90" y="338">{copy.endpoints[0]}</text>
    </g>
    <g class="node node-endpoint">
      <rect x="225" y="265" width="170" height="105" rx="10"></rect>
      <text class="node-kicker" x="310" y="302">VLAN 20</text>
      <text class="node-label" x="310" y="338">{copy.endpoints[1]}</text>
    </g>
    <g class="node node-endpoint">
      <rect x="445" y="265" width="170" height="105" rx="10"></rect>
      <text class="node-kicker" x="530" y="302">VLAN 30</text>
      <text class="node-label" x="530" y="338">{copy.endpoints[2]}</text>
    </g>
  </svg>
</figure>
