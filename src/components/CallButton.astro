---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { company } from '../data/company';
interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className = 'button-secondary' } = Astro.props;
---

<a class:list={['button', 'call-action', className]} href={company.publicPhoneHref}>
  <svg viewBox="0 0 24 24" aria-hidden="true"
    ><path
      d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a13 13 0 0 1-6-6l2-2z"
    ></path></svg
  >
  <span>{getUi(locale).common.phoneAction}</span>
</a>
