---
import type { Locale } from '../i18n/config';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = {
  pl: ['Potrzebujesz pomocy jako osoba prywatna?', 'https://naserwis.pl/'],
  ru: ['Нужна помощь частному лицу?', 'https://naserwis.pl/ru/'],
  en: ['Need help as a private individual?', 'https://naserwis.pl/en/'],
  uk: ['Потрібна допомога приватній особі?', 'https://naserwis.pl/uk/'],
}[locale];
---

<p class="private-support">{copy[0]} <a href={copy[1]}>NaSerwis.pl</a></p>
