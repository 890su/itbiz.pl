---
import { getRoute, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { company } from '../data/company';
interface Props {
  locale: Locale;
  compact?: boolean;
  class?: string;
}
const { locale, compact = false, class: className } = Astro.props;
const copy = getUi(locale).common;
---

<div
  class:list={['contact-actions', { 'contact-actions--compact': compact }, className]}
>
  <a
    class="button button-primary"
    href={getRoute(locale, 'contact')}
    data-enquiry-open
    aria-haspopup="dialog"
    aria-controls="enquiry-dialog"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path></svg
    ><span>{copy.cta}</span>
  </a>
  <a class="button button-contact" href={company.publicPhoneHref}>
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a13 13 0 0 1-6-6l2-2z"
      ></path></svg
    ><span>{copy.phoneAction}{!compact && <strong>{company.publicPhone}</strong>}</span>
  </a>
</div>
