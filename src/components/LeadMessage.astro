---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { getExperience } from '../i18n/experience';
import { getEnquiry } from '../i18n/enquiry';

interface Props {
  locale: Locale;
  progressive: boolean;
  messageHelp: string;
}
const { locale, progressive, messageHelp } = Astro.props;
const copy = getUi(locale).form;
const validation = getExperience(locale).form;
---

<div class="field field-wide enquiry-message">
  <label class:list={{ 'visually-hidden': progressive }} for="message">
    {copy.message}
  </label>
  <textarea
    id="message"
    name="message"
    maxlength="3000"
    minlength="20"
    rows="3"
    required
    placeholder={progressive ? getEnquiry(locale).placeholder : undefined}
    aria-describedby="message-help message-minimum message-error"
    data-validation-message={validation.messageError}></textarea>
  {!progressive && <small id="message-help">{messageHelp}</small>}
  <small id="message-minimum">{validation.minimum}</small>
  <small id="message-error" class="field-error" hidden></small>
</div>
