---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import { getExperience } from '../i18n/experience';
import { getEnquiry } from '../i18n/enquiry';
interface Props {
  locale: Locale;
  progressive: boolean;
  idPrefix: string;
}
const { locale, progressive, idPrefix } = Astro.props;
const copy = getUi(locale).form;
const validation = getExperience(locale).form;
const id = `${idPrefix}message`;
---

<div class="field field-wide enquiry-message">
  <label class="visually-hidden" for={id}>{copy.message}</label>
  <textarea
    id={id}
    name="message"
    maxlength="3000"
    minlength="20"
    rows="3"
    required
    placeholder={progressive ? getEnquiry(locale).placeholder : copy.message}
    aria-describedby={`${id}-minimum`}
    data-validation-message={validation.minimum}
    data-validation-target={`${id}-minimum`}></textarea>
  <small id={`${id}-minimum`} data-field-guidance>{validation.minimum}</small>
</div>
