---
import { getRoute, type Locale, type TranslationKey } from '../i18n/config';
import { getUi } from '../i18n/ui';
import ServicesMenu from './ServicesMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ContactActions from './ContactActions.astro';
interface Props {
  variant: 'desktop' | 'mobile';
  locale: Locale;
  translationKey: TranslationKey;
}
const { variant, locale, translationKey } = Astro.props;
const copy = getUi(locale);
const navigation: { href: string; label: string }[] = (
  ['home', 'services', 'solutions', 'about', 'contact'] as TranslationKey[]
).map((key, index) => ({
  href: getRoute(locale, key),
  label: copy.common.nav[index]!,
}));
navigation.splice(4, 0, {
  href: getRoute(locale, 'networkWeather'),
  label: {
    pl: 'Stan łącza',
    ru: 'Состояние сети',
    en: 'Network status',
    uk: 'Стан мережі',
  }[locale],
});
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === getRoute(locale, 'home')
    ? currentPath === href
    : currentPath.startsWith(href);
---

{
  variant === 'desktop' ? (
    <aside class="side-panel" aria-label={copy.common.siteNav}>
      <div class="side-heading">
        <a
          class="brand"
          href={getRoute(locale, 'home')}
          aria-label={copy.common.brandHome}
        >
          <>
            <span class="brand-node" aria-hidden="true" />
            <span>ITBIZ.PL</span>
          </>
        </a>
        <p class="side-kicker">
          {copy.common.sideKicker[0]}
          <br />
          {copy.common.sideKicker[1]}
        </p>
        <div class="utility-row">
          <>
            <LanguageSwitcher {locale} {translationKey} />
            <button
              class="theme-toggle"
              type="button"
              data-theme-toggle
              aria-label={copy.common.theme}
            >
              <span aria-hidden="true">◐</span>
            </button>
          </>
        </div>
      </div>
      <div class="side-navigation">
        <nav class="side-nav" aria-label={copy.common.mainNav}>
          <ul>
            {navigation.map((item) => (
              <li>
                {item.href === getRoute(locale, 'services') ? (
                  <ServicesMenu {locale} />
                ) : (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    <span>{item.label}</span>
                    <span class="nav-port" aria-hidden="true" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <ContactActions {locale} class="side-actions" />
      </div>
    </aside>
  ) : (
    <>
      <header class="mobile-bar">
        <a
          class="brand mobile-brand"
          href={getRoute(locale, 'home')}
          aria-label={copy.common.brandHome}
        >
          <>
            <span class="brand-node" aria-hidden="true" />
            <span>ITBIZ.PL</span>
          </>
        </a>
        <LanguageSwitcher {locale} {translationKey} mobile />
        <div class="mobile-actions">
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={copy.common.theme}
          >
            <span aria-hidden="true">◐</span>
          </button>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={copy.common.menu}
          >
            <span class="menu-icon" aria-hidden="true" />
          </button>
        </div>
        <nav
          id="mobile-menu"
          class="mobile-menu"
          aria-label={copy.common.mainNav}
          hidden
        >
          <div class="mobile-menu-scroll">
            <ul>
              {navigation.map((item) => (
                <li>
                  {item.href === getRoute(locale, 'services') ? (
                    <ServicesMenu {locale} />
                  ) : (
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <ContactActions {locale} compact class="mobile-menu-actions" />
        </nav>
      </header>
      <ContactActions {locale} compact class="mobile-contact-bar" />
    </>
  )
}
